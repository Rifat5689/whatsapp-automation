NODE_ENV=development
PORT=3001
# Exact allowed browser origins, comma-separated when more than one is required.
FRONTEND_ORIGIN=http://localhost:5173

# Keep the real URI only in backend/.env. URL-encode special password characters.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority

OWNER_USERNAME=
OWNER_PASSWORD=
# Generate a long random value; never reuse the owner password.
JWT_SECRET=

# Server-side AI credentials. Model values are comma-separated in fallback order.
OPENROUTER_API_KEY=
OPENROUTER_MODELS=openrouter/free
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash

MESSAGING_PROVIDER=mock
TELEGRAM_BOT_TOKEN=
# 1-256 characters using only A-Z, a-z, 0-9, underscore, and hyphen.
TELEGRAM_WEBHOOK_SECRET=

STORAGE_PROVIDER=local
CLOUD_STORAGE_ACCOUNT_ID=
CLOUD_STORAGE_ACCESS_KEY=
CLOUD_STORAGE_SECRET_KEY=
CLOUD_STORAGE_BUCKET=
