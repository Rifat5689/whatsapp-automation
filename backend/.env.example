NODE_ENV=development
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173

# Keep the real URI only in backend/.env. URL-encode special password characters.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority

OWNER_EMAIL=owner@example.com
# Generate: npm run hash-password -w backend -- "a-long-private-password"
OWNER_PASSWORD_HASH=
# Generate a long random value; never reuse the owner password.
JWT_SECRET=

# Supported locally: mock. Production adapters remain deployment tasks.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

MESSAGING_PROVIDER=mock
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

STORAGE_PROVIDER=local
AWS_REGION=
AWS_S3_BUCKET=
# Prefer an AWS runtime role in deployment; these are optional for local use.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
